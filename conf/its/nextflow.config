conda.enabled = true
docker.enabled = true

conda {
cacheDir = '/mnt/c/sanger/nf-templates/conda'
}

profiles {
    github {
        process.cpus = 2
        process.memory = "6.5G"
    }

   server {
       process.cpus = 24
       process.memory = "58G"
   }
}

params {
  sample_dir = "data"
  outdir = "results-its"
  blastdb = "/mnt/c/sanger/reference_databases/its_unite/fungi_unite_25072023"
  taxonomy = "/mnt/c/sanger/reference_databases/bac120_taxonomy_r220.tsv.gz"
  fastp_args = "-L --n_base_limit 20" //use this for ambiguous reads (like ITS)
}
