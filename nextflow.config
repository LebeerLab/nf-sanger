conda.enabled = true

conda {
cacheDir = '/mnt/b/seqdata/sanger/nf-templates/conda'
}

profiles {
    github {
        process.cpus = 2
        process.memory = "6.5G"
    }

   server {
       process.cpus = 24
       process.memory = "58G"
   }
}

params {
  sample_dir = "data"
  outdir = "results-nf"
  blastdb = "/mnt/b/seqdata/sanger/reference_databases/bac120_ssu_reps_r214.fna"
  taxonomy = "/mnt/b/seqdata/sanger/reference_databases/bac120_taxonomy_r214.tsv.gz"
  //fastp_args = "-L --n_base_limit 20" //use this for ambiguous reads (like ITS)
}
