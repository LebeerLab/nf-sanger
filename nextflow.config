conda.enabled = true
docker.enabled = true

profiles {
    github {
        process.cpus = 2
        process.memory = "6.5G"
    }

   server {
       process.cpus = 24
       process.memory = "58G"
   }
}

params {
  sample_dir = "data"
  outdir = "results"
  blastdb = "/mnt/b/seqdata/sanger/reference_databases/bac120_ssu_reps_r95"
  taxonomy = "/mnt/b/seqdata/sanger/reference_databases/bac120_taxonomy_r95.tsv.gz"
}
